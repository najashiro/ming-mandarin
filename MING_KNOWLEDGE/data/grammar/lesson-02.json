[{"id":"GR-007","lesson":2,"topic":"Oraciones con 是","rule_source_summary":"A 是 B identifica o clasifica personas/cosas.","examples":["这是马大为。","她是老师。"],"source_refs":[{"source_id":"SRC-BOOK-01-02","pages":[72,73],"role":"evidence"},{"source_id":"SRC-PPT-02-2","pages":[28],"role":"evidence"}]},{"id":"GR-008","lesson":2,"topic":"Negación con 不是","rule_source_summary":"不 se coloca antes de 是 para negar la identificación.","examples":["那不是饺子。","我不是上海人。"],"source_refs":[{"source_id":"SRC-BOOK-01-02","pages":[72,73],"role":"evidence"},{"source_id":"SRC-PPT-02-2","pages":[29,30],"role":"evidence"}]},{"id":"GR-009","lesson":2,"topic":"Pronombre interrogativo 什么","rule_source_summary":"什么 sustituye el elemento desconocido sin alterar el orden declarativo.","examples":["这是什么？","你吃什么？"],"source_refs":[{"source_id":"SRC-BOOK-01-02","pages":[73],"role":"evidence"},{"source_id":"SRC-PPT-02-2","pages":[34,35],"role":"evidence"}]},{"id":"GR-010","lesson":2,"topic":"Pronombre interrogativo 谁","rule_source_summary":"谁 pregunta por una persona.","examples":["他是谁？","谁学习汉语？"],"source_refs":[{"source_id":"SRC-PPT-02-2","pages":[34,36],"role":"evidence"}]},{"id":"GR-011","lesson":2,"topic":"哪国人 para nacionalidad","rule_source_summary":"哪 + 国 + 人 forma la pregunta de nacionalidad.","examples":["你是哪国人？","他是哪国人？"],"source_refs":[{"source_id":"SRC-BOOK-01-02","pages":[66,72,73],"role":"evidence"},{"source_id":"SRC-PPT-02-1","pages":[],"role":"evidence"}]},{"id":"GR-012","lesson":2,"topic":"Adverbio 也 en identificación","rule_source_summary":"也 se coloca después del sujeto y antes del predicado, incluido 是.","examples":["我也学习汉语。","她也是老师。"],"source_refs":[{"source_id":"SRC-PPT-02-1","pages":[],"role":"evidence"},{"source_id":"SRC-PPT-02-2","pages":[28],"role":"evidence"}]},{"id":"GR-013","lesson":2,"topic":"Adverbio 都","rule_source_summary":"都 indica totalidad de los miembros del sujeto plural.","examples":["他们都学习汉语。","包子和饺子都很好吃。"],"source_refs":[{"source_id":"SRC-PPT-02-2","pages":[11,18],"role":"evidence"}]},{"id":"GR-014","lesson":2,"topic":"喜欢 + verbo/objeto","rule_source_summary":"喜欢 expresa gusto y puede ir seguido de un objeto o de un verbo como 吃.","examples":["她喜欢吃面条和饺子。","你喜欢什么？"],"source_refs":[{"source_id":"SRC-BOOK-01-02","pages":[69,70],"role":"evidence"},{"source_id":"SRC-PPT-02-2","pages":[8,18],"role":"evidence"}]},{"id":"GR-015","lesson":2,"topic":"要 + objeto","rule_source_summary":"要 expresa querer/pedir algo; la negación mostrada es 不要.","examples":["我要咖啡。","我不要咖啡。"],"source_refs":[{"source_id":"SRC-PPT-02-2","pages":[16,25],"role":"evidence"}]}]