[{"id":"GR-001","lesson":1,"topic":"Predicado adjetival con 很","rule_source_summary":"La fuente presenta Sujeto + 很 + adjetivo como patrón afirmativo.","examples":["我很好。","他很忙。"],"source_refs":[{"source_id":"SRC-BOOK-01-02","pages":[51],"role":"evidence"},{"source_id":"SRC-PPT-01-1","pages":[22],"role":"evidence"}],"notes":null},{"id":"GR-002","lesson":1,"topic":"Negación con 不 / 不太","rule_source_summary":"不 precede al adjetivo; 不太 + adjetivo expresa “no muy…”.","examples":["他不忙。","我不太忙。"],"source_refs":[{"source_id":"SRC-BOOK-01-02","pages":[51],"role":"evidence"},{"source_id":"SRC-PPT-01-1","pages":[22,54,56],"role":"evidence"}],"notes":"La presentación marca 他不很忙 como no aceptado en este nivel; se conserva el encuadre de la fuente."},{"id":"GR-003","lesson":1,"topic":"Preguntas sí/no con 吗","rule_source_summary":"Añadir 吗 al final de una declarativa para formar una pregunta de sí/no.","examples":["你忙吗？","林娜在吗？"],"source_refs":[{"source_id":"SRC-BOOK-01-02","pages":[50],"role":"evidence"},{"source_id":"SRC-PPT-01-1","pages":[63],"role":"evidence"}],"notes":null},{"id":"GR-004","lesson":1,"topic":"Pregunta elíptica con 呢","rule_source_summary":"呢 permite devolver o elidir una pregunta ya establecida por el contexto.","examples":["我很好。你呢？","我叫Ana，你呢？"],"source_refs":[{"source_id":"SRC-BOOK-01-02","pages":[49],"role":"evidence"},{"source_id":"SRC-PPT-01-1","pages":[55],"role":"evidence"}],"notes":null},{"id":"GR-005","lesson":1,"topic":"Adverbio 也","rule_source_summary":"也 va después del sujeto y antes del verbo/adjetivo predicativo.","examples":["他也姓马。","我也不忙。","林娜也很高兴。"],"source_refs":[{"source_id":"SRC-BOOK-01-02","pages":[52],"role":"evidence"},{"source_id":"SRC-PPT-01-1","pages":[66],"role":"evidence"}],"notes":null},{"id":"GR-006","lesson":1,"topic":"太 + adjetivo + 了 / 不太","rule_source_summary":"La presentación introduce 太 + adjetivo (+了) para grado alto y 不太 para “no muy”.","examples":["太忙了。","我不太忙。"],"source_refs":[{"source_id":"SRC-PPT-01-1","pages":[54],"role":"evidence"}],"notes":null}]