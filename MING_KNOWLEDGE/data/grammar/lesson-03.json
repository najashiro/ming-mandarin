[{"id":"GR-016","lesson":3,"topic":"Oraciones con 有 / 没有","rule_source_summary":"有 expresa posesión/existencia; la negación es 没有, no 不有.","examples":["我有一个哥哥。","她没有妹妹。"],"source_refs":[{"source_id":"SRC-BOOK-03","pages":[8,9],"role":"evidence"},{"source_id":"SRC-PPT-03-1","pages":[39],"role":"evidence"}]},{"id":"GR-017","lesson":3,"topic":"Posesión con 的","rule_source_summary":"Pronombre/sustantivo + 的 + sustantivo expresa posesión o modificación.","examples":["我们家的照片","妈妈的照片"],"source_refs":[{"source_id":"SRC-BOOK-03","pages":[10,11],"role":"evidence"},{"source_id":"SRC-PPT-03-1","pages":[40],"role":"evidence"}]},{"id":"GR-018","lesson":3,"topic":"Omisión de 的 con relaciones cercanas","rule_source_summary":"La fuente permite omitir 的 con ciertos familiares, residencia o lugar de trabajo.","examples":["我妈妈","你女儿","他们家"],"source_refs":[{"source_id":"SRC-BOOK-03","pages":[10],"role":"evidence"},{"source_id":"SRC-PPT-03-1","pages":[40],"role":"evidence"}]},{"id":"GR-019","lesson":3,"topic":"Numeral + clasificador + sustantivo","rule_source_summary":"El numeral normalmente requiere clasificador antes del sustantivo.","examples":["六口人","两个姐姐","三张照片"],"source_refs":[{"source_id":"SRC-BOOK-03","pages":[11,12],"role":"evidence"},{"source_id":"SRC-PPT-03-1","pages":[17,18,19],"role":"evidence"}]},{"id":"GR-020","lesson":3,"topic":"Clasificadores 口、个、张","rule_source_summary":"口 para miembros de familia; 个 general; 张 para objetos planos.","examples":["五口人","一个朋友","一张照片"],"source_refs":[{"source_id":"SRC-BOOK-03","pages":[11,12],"role":"evidence"},{"source_id":"SRC-PPT-03-1","pages":[18,19,20],"role":"evidence"}]},{"id":"GR-021","lesson":3,"topic":"两 antes de clasificador","rule_source_summary":"La fuente enseña 两, no 二, antes de clasificador en este patrón.","examples":["两个人","两张照片","两口人"],"source_refs":[{"source_id":"SRC-BOOK-03","pages":[11,12],"role":"evidence"},{"source_id":"SRC-PPT-03-1","pages":[16],"role":"evidence"}]},{"id":"GR-022","lesson":3,"topic":"几 para cantidades","rule_source_summary":"几 reemplaza la cantidad desconocida manteniendo el clasificador.","examples":["你家有几口人？","你有几个朋友？","你有几张照片？"],"source_refs":[{"source_id":"SRC-BOOK-03","pages":[13,14],"role":"evidence"},{"source_id":"SRC-PPT-03-1","pages":[10,44],"role":"evidence"}]},{"id":"GR-023","lesson":3,"topic":"Adverbio 还 + verbo","rule_source_summary":"还 añade información y se coloca antes del verbo, después del sujeto.","examples":["我有一个姐姐，还有一个妹妹。","我学习汉语，还学习英语。"],"source_refs":[{"source_id":"SRC-BOOK-03","pages":[14],"role":"evidence"},{"source_id":"SRC-PPT-03-1","pages":[24],"role":"evidence"}]},{"id":"GR-024","lesson":3,"topic":"真 + adjetivo","rule_source_summary":"真 delante de un adjetivo expresa énfasis/exclamación.","examples":["你们家真漂亮！","中国的孩子真忙！"],"source_refs":[{"source_id":"SRC-BOOK-03","pages":[7],"role":"notes"}]}]