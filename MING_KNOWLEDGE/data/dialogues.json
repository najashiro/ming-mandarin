[{"id":"L1-D001","lesson":1,"title":"Encuentro por primera vez","lines":[{"zh":"请问，你叫什么名字？","pinyin":"Qǐngwèn, nǐ jiào shénme míngzi?","es":"Disculpe, ¿cómo te llamas?"},{"zh":"认识你很高兴。","pinyin":"Rènshi nǐ hěn gāoxìng.","es":"Encantado/a de conocerte."}],"sources":["SRC-PPT-01-1"],"status":"verified_excerpt"},{"id":"L1-D002","lesson":1,"title":"Saludo y estado reciente","lines":[{"zh":"你最近怎么样？","pinyin":"Nǐ zuìjìn zěnmeyàng?","es":"¿Cómo has estado últimamente?"},{"zh":"马马虎虎。","pinyin":"Mǎma hūhu.","es":"Más o menos."}],"sources":["SRC-PPT-01-1"],"status":"verified_excerpt"},{"id":"L2-D001","lesson":2,"title":"Texto 1 — Presentación y nacionalidad","lines":[{"speaker":"丁力波","zh":"老师，早上好！"},{"speaker":"陈老师","zh":"你们好！"},{"speaker":"丁力波","zh":"这是马大为，他是我朋友，刚到北京。"},{"speaker":"马大为","zh":"您好！您贵姓？"},{"speaker":"陈老师","zh":"我姓陈，你是哪国人？"},{"speaker":"马大为","zh":"我是美国人，我也学习汉语。陈老师，认识您很高兴。"},{"speaker":"王小云","zh":"认识你我也很高兴。"},{"speaker":"马大为","zh":"老师，再见！"},{"speaker":"陈老师","zh":"再见！"}],"sources":["SRC-PPT-02-1"],"status":"verified"},{"id":"L2-D002","lesson":2,"title":"Texto 2 — Comidas y gustos","lines":[{"speaker":"马大为","zh":"小云，这是什么？"},{"speaker":"王小云","zh":"这是点心。"},{"speaker":"马大为","zh":"点心好吃吗？"},{"speaker":"王小云","zh":"好吃，我爸爸是上海人，他喜欢吃点心和米饭。"},{"speaker":"马大为","zh":"北京人喜欢吃什么？"},{"speaker":"王小云","zh":"我妈妈是北京人，她喜欢吃面条和饺子。"}],"sources":["SRC-PPT-02-2"],"status":"verified"},{"id":"L2-D003","lesson":2,"title":"Texto 2 — 包子 y 饺子","lines":[{"speaker":"马大为","zh":"这是饺子吗？"},{"speaker":"王小云","zh":"这不是饺子，是包子。包子大，饺子小，你看，那是饺子。"},{"speaker":"马大为","zh":"包子好吃吗？"},{"speaker":"王小云","zh":"包子和饺子都很好吃。"},{"speaker":"马大为","zh":"好，我要包子，也要饺子。"}],"sources":["SRC-PPT-02-2"],"status":"verified"},{"id":"L3-D001","lesson":3,"title":"Familia y fotografía","lines":[{"speaker":"林娜","zh":"你们家有几口人？"},{"speaker":"王小云","zh":"我们家有四口人。你看，这是我们家的照片。"},{"speaker":"林娜","zh":"你爸爸妈妈做什么工作？"},{"speaker":"王小云","zh":"我爸爸是医生，妈妈是老师。"},{"speaker":"林娜","zh":"这是你弟弟吗？"},{"speaker":"王小云","zh":"这不是我弟弟。这是我哥哥。"}],"sources":["SRC-PPT-03-1","SRC-BOOK-03"],"status":"verified"},{"id":"L3-D002","lesson":3,"title":"Familia ampliada y 贝贝","lines":[{"speaker":"王小云","zh":"林娜，你们家有几口人？"},{"speaker":"林娜","zh":"我们家一共有六口人：妈妈、一个哥哥、两个姐姐和我，还有贝贝。"},{"speaker":"王小云","zh":"贝贝是谁？是你妹妹吗？"},{"speaker":"林娜","zh":"我没有妹妹，贝贝是我的小狗。"},{"speaker":"王小云","zh":"小狗也是一口人吗？"}],"sources":["SRC-PPT-03-1","SRC-BOOK-03"],"status":"verified"},{"id":"L3-D003","lesson":3,"title":"Texto 2 — Visita, hija, edad y clases","lines":[{"speaker":"陆雨平","zh":"你们好！请进！"},{"speaker":"林娜","zh":"您好！你们家真漂亮！"},{"speaker":"陆雨平","zh":"谢谢。请坐。你们喝什么？我们家有茶和咖啡。"},{"speaker":"宋华","zh":"我喝咖啡。"},{"speaker":"林娜","zh":"我要茶。"},{"speaker":"宋华","zh":"这张照片真漂亮！这是你女儿吗？"},{"speaker":"陆雨平","zh":"是。这是我女儿。"},{"speaker":"宋华","zh":"你女儿今年几岁？"},{"speaker":"陆雨平","zh":"五岁。今天她有钢琴课，不在家。"},{"speaker":"林娜","zh":"中国的孩子真忙！"},{"speaker":"陆雨平","zh":"是啊。晚上她还有英语课。"}],"sources":["SRC-BOOK-03"],"source_pages":[5,6,7],"status":"verified"}]