[{"id":"PH-001","lesson":1,"zh":"你好！","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-002","lesson":1,"zh":"我叫马大为。","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-003","lesson":1,"zh":"请问，你叫什么名字？","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-004","lesson":1,"zh":"我姓宋，叫宋华。","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-005","lesson":1,"zh":"认识你很高兴。","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-006","lesson":1,"zh":"认识你我也很高兴。","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-007","lesson":1,"zh":"请问，林娜在吗？","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-008","lesson":1,"zh":"在。力波，请进，请坐。","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-009","lesson":1,"zh":"谢谢。你最近怎么样？","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-010","lesson":1,"zh":"我很好。你呢？","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-011","lesson":1,"zh":"我很忙。你忙吗？","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-012","lesson":1,"zh":"我不太忙。大为好吗？","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-013","lesson":1,"zh":"他也很好。","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-014","lesson":1,"zh":"你在哪儿？","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-015","lesson":1,"zh":"老师在这儿吗？","source_refs":[{"source_id":"SRC-PPT-01-1","role":"verified_phrase"}]},{"id":"PH-016","lesson":2,"zh":"老师，早上好！","source_refs":[{"source_id":"SRC-PPT-02-1","role":"verified_phrase"}]},{"id":"PH-017","lesson":2,"zh":"这是马大为，他是我朋友，刚到北京。","source_refs":[{"source_id":"SRC-PPT-02-1","role":"verified_phrase"}]},{"id":"PH-018","lesson":2,"zh":"您好！您贵姓？","source_refs":[{"source_id":"SRC-PPT-02-1","role":"verified_phrase"}]},{"id":"PH-019","lesson":2,"zh":"我姓陈，你是哪国人？","source_refs":[{"source_id":"SRC-PPT-02-1","role":"verified_phrase"}]},{"id":"PH-020","lesson":2,"zh":"我是美国人，我也学习汉语。","source_refs":[{"source_id":"SRC-PPT-02-1","role":"verified_phrase"}]},{"id":"PH-021","lesson":2,"zh":"老师，再见！","source_refs":[{"source_id":"SRC-PPT-02-1","role":"verified_phrase"}]},{"id":"PH-022","lesson":2,"zh":"小云，这是什么？","source_refs":[{"source_id":"SRC-PPT-02-2","role":"verified_phrase"}]},{"id":"PH-023","lesson":2,"zh":"这是点心。","source_refs":[{"source_id":"SRC-PPT-02-2","role":"verified_phrase"}]},{"id":"PH-024","lesson":2,"zh":"点心好吃吗？","source_refs":[{"source_id":"SRC-PPT-02-2","role":"verified_phrase"}]},{"id":"PH-025","lesson":2,"zh":"好吃，我爸爸是上海人，他喜欢吃点心和米饭。","source_refs":[{"source_id":"SRC-PPT-02-2","role":"verified_phrase"}]},{"id":"PH-026","lesson":2,"zh":"北京人喜欢吃什么？","source_refs":[{"source_id":"SRC-PPT-02-2","role":"verified_phrase"}]},{"id":"PH-027","lesson":2,"zh":"我妈妈是北京人，她喜欢吃面条和饺子。","source_refs":[{"source_id":"SRC-PPT-02-2","role":"verified_phrase"}]},{"id":"PH-028","lesson":2,"zh":"这是饺子吗？","source_refs":[{"source_id":"SRC-PPT-02-2","role":"verified_phrase"}]},{"id":"PH-029","lesson":2,"zh":"这不是饺子，是包子。","source_refs":[{"source_id":"SRC-PPT-02-2","role":"verified_phrase"}]},{"id":"PH-030","lesson":2,"zh":"包子和饺子都很好吃。","source_refs":[{"source_id":"SRC-PPT-02-2","role":"verified_phrase"}]},{"id":"PH-031","lesson":2,"zh":"好，我要包子，也要饺子。","source_refs":[{"source_id":"SRC-PPT-02-2","role":"verified_phrase"}]},{"id":"PH-032","lesson":3,"zh":"你们家有几口人？","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-033","lesson":3,"zh":"我们家有四口人。","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-034","lesson":3,"zh":"你看，这是我们家的照片。","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-035","lesson":3,"zh":"你爸爸妈妈做什么工作？","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-036","lesson":3,"zh":"我爸爸是医生，妈妈是老师。","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-037","lesson":3,"zh":"这是你弟弟吗？","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-038","lesson":3,"zh":"这不是我弟弟。这是我哥哥。","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-039","lesson":3,"zh":"我们家一共有六口人：妈妈、一个哥哥、两个姐姐和我，还有贝贝。","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-040","lesson":3,"zh":"贝贝是谁？是你妹妹吗？","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-041","lesson":3,"zh":"我没有妹妹，贝贝是我的小狗。","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-042","lesson":3,"zh":"你们好！请进！","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-043","lesson":3,"zh":"你们家真漂亮！","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-044","lesson":3,"zh":"你们喝什么？我们家有茶和咖啡。","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-045","lesson":3,"zh":"这张照片真漂亮！这是你女儿吗？","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]},{"id":"PH-046","lesson":3,"zh":"你女儿今年几岁？","source_refs":[{"source_id":"SRC-BOOK-03","role":"verified_phrase"}]}]