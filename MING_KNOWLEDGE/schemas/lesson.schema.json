{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ming Lesson Index",
  "type": "object",
  "required": [
    "lesson",
    "title",
    "vocabulary",
    "grammar",
    "dialogues",
    "source_ids"
  ],
  "properties": {
    "lesson": {
      "type": "integer"
    },
    "title": {
      "type": "object"
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grammar": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dialogues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}