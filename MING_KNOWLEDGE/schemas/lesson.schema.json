{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ming Lesson Index v1.0",
  "type": "object",
  "required": [
    "lesson",
    "title",
    "version",
    "audit_complete",
    "vocabulary_shards",
    "grammar_shard",
    "dialogue_ids",
    "phrase_ids",
    "source_ids"
  ],
  "properties": {
    "lesson": {"type": "integer", "minimum": 1},
    "title": {
      "type": "object",
      "required": ["zh", "pinyin", "es"],
      "properties": {
        "zh": {"type": "string"},
        "pinyin": {"type": "string"},
        "es": {"type": "string"}
      },
      "additionalProperties": false
    },
    "version": {"const": "1.0.0"},
    "audit_complete": {"type": "boolean"},
    "vocabulary_shards": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^data/vocabulary/lesson-"},
      "uniqueItems": true
    },
    "grammar_shard": {"type": "string", "pattern": "^data/grammar/lesson-"},
    "dialogue_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^L[1-9][0-9]*-D[0-9]{3}$"},
      "uniqueItems": true
    },
    "phrase_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^PH-[0-9]{3}$"},
      "uniqueItems": true
    },
    "source_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^SRC-"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
