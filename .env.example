# Lista separada por comas. Si queda vacía, /admin/content exige login pero acepta cualquier cuenta.
ADMIN_EMAILS=docente@example.com

# Solo para una futura adaptación a Supabase; Sites usa ChatGPT Auth + D1 + R2.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-never-expose-to-browser
SUPABASE_CERTIFICATES_BUCKET=certificates
