# Supabase: se sincronizan automáticamente con Vercel mediante la integración oficial.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_server_only_never_expose_to_browser

# URL canónica de producción. En desarrollo se usa http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://ming-mandarin-najashiro.vercel.app

# Lista separada por comas para proteger /admin/content y /admin/community.
ADMIN_EMAILS=admin@example.com

# Interruptor y límites de Comunidad V1. Son variables privadas del servidor.
COMMUNITY_ENABLED=true
COMMUNITY_THREAD_LIMIT=3
COMMUNITY_REPLY_LIMIT=12
